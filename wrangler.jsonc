{
  // Local dev/CI uses --local. User approved automated deploy only for life-log-uat via GitHub Actions; no automatic remote migrations or other-app/Production changes.
  "name": "life-log-dev",
  "compatibility_date": "2026-11-04",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "life-log-dev",
    "database_id": "421d0116-5c33-4782-a2b6-28f9684d3956",
    "migrations_dir": "migrations"
  }],
  // User-approved single remote D1 reuse; never point this Worker at another app's database.
  // GitHub main push may deploy the protected UAT Worker; remote schema SQL/Migration and Production are separate operations.
  "env": {
    "uat": {
      "name": "life-log-uat",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "life-log-dev",
        "database_id": "421d0116-5c33-4782-a2b6-28f9684d3956",
        "migrations_dir": "migrations"
      }],
      "vars": {
        "MANUAL_REMOTE_WRITE_ENABLED": "false",
        "MANUAL_REMOTE_TARGET": "uat",
        "MANUAL_REMOTE_ORIGIN": "https://life-log-uat.ha-rookie.workers.dev"
      }
    }
  }

}
