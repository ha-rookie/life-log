{
  "name": "life-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:schema": "python3 scripts/validate-schema.py",
    "db:migrate:local": "wrangler d1 migrations apply life-log-dev --local",
    "db:fixture:local": "wrangler d1 execute life-log-dev --local --file tests/fixtures/synthetic.sql"
  },
  "dependencies": {
    "jose": "6.2.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
